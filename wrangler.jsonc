{
  // Cloudflare Workers (Static Assets) কনফিগ — `npx wrangler deploy`
  // Pages ব্যবহার করলে এই ফাইল লাগে না: docs/DEPLOYMENT.md দেখুন।
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqra-mahfil-frame",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
