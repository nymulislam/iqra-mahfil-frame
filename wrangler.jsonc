{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iqra-mahfil-frame",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/live/*"
    ]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "main": "worker/live.js",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE",
        "class_name": "LiveCounters"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-live",
      "new_sqlite_classes": [
        "LiveCounters"
      ]
    }
  ]
}
